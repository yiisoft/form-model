{
    "source": {
        "directories": [
            "src"
        ]
    },
    "logs": {
        "text": "php:\/\/stderr",
        "stryker": {
            "report": "master"
        }
    },
    "mutators": {
        "@default": true,
        "AssignCoalesce": {
            "ignoreSourceCodeByRegex": [
                "self::\\$inflector \\?\\?= new Inflector\\(\\);"
            ]
        },
        "FunctionCallRemoval": {
            "ignoreSourceCodeByRegex": [
                "array_pop\\(\\$keys\\);"
            ]
        },
        "TrueValue": {
            "ignoreSourceCodeByRegex": [
                "\\$parser = new ObjectParser\\(\\$model, skipStaticProperties: true\\);"
            ]
        }
    }
}
